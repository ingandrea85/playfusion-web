# Production build env for the E1 organizer SPA.
# Vite bakes VITE_* at build time (`vite build` loads .env.production). Without these,
# readConfig() yields auth0=undefined and the app shows the "Config Auth0 mancante" card
# instead of redirecting to the Auth0 login. These are the recycled v1 tenant's public
# SPA identifiers (same values as .env.example / infra/cdk/env/stg.json) — non-secret.
VITE_AUTH0_DOMAIN=dev-c6din8ya.eu.auth0.com
VITE_AUTH0_CLIENT_ID=65atFepkIh2jiMeaDqZlqgD63ccd2Gw1
VITE_AUTH0_AUDIENCE=https://plafusionapi.it

# Backend API for post-login data calls. rest-client joins as `${baseUrl}${path}` where
# path already starts with '/', so NO trailing slash here. This is the stg ApiStack API
# Gateway stage root (CDK output). Without it, apiBaseUrl='' and the dashboard fetches
# relative to CloudFront (HTML, not JSON) → runScreen renders the generic error card.
VITE_API_BASE_URL=https://hnvcmo803a.execute-api.eu-south-1.amazonaws.com/prod
# Fallback org when the Auth0 token carries no org_id claim; matches the seeded pilot org.
VITE_DEFAULT_ORG_ID=org-pilot
