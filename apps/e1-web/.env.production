# Production build env for the E1 organizer SPA.
# Vite bakes VITE_* at build time (`vite build` loads .env.production). Without these,
# readConfig() yields auth0=undefined and the app shows the "Config Auth0 mancante" card
# instead of redirecting to the Auth0 login. These are the recycled v1 tenant's public
# SPA identifiers (same values as .env.example / infra/cdk/env/stg.json) — non-secret.
VITE_AUTH0_DOMAIN=dev-c6din8ya.eu.auth0.com
VITE_AUTH0_CLIENT_ID=65atFepkIh2jiMeaDqZlqgD63ccd2Gw1
VITE_AUTH0_AUDIENCE=https://plafusionapi.it

# VITE_API_BASE_URL / VITE_DEFAULT_ORG_ID gate post-login data calls, not the login page.
# Set VITE_API_BASE_URL to the deployed ApiStack API Gateway URL (and VITE_DEFAULT_ORG_ID
# to a seeded org) once known — leaving them unset does not block the Auth0 login flow.
