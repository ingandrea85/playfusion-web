{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "lib": ["ES2022"],
    "types": ["node"],
    "baseUrl": ".",
    // Path aliases map each workspace package name to its source entry so internal
    // imports resolve as *internal* (not node_modules), which is what lets
    // @nx/enforce-module-boundaries (ADR-011) see and police cross-layer imports.
    // Real libs/services replace these placeholder entries in S0.2 / S0.5.
    "paths": {
      "@playfusion/platform-lib": ["libs/platform-lib/src/index.ts"],
      "@playfusion/tokens": ["libs/tokens/src/index.ts"],
      "@playfusion/ui": ["libs/ui/src/index.ts"],
      "@playfusion/rest-client": ["libs/rest-client/src/index.ts"],
      "@playfusion/app-shell": ["libs/app-shell/src/index.ts"]
    }
  }
}
