{
  "name": "playfusion-web",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20 <21" },
  "workspaces": [
    "apps/*",
    "libs/*",
    "services/*",
    "infra/*",
    "mockups"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "vitest run --project unit",
    "test:it": "vitest run --project integration",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
    "provision": "tsx scripts/provision.ts",
    "stack:up": "docker compose up -d",
    "stack:down": "docker compose down",
    "mockups": "npm run dev -w @playfusion/mockups"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.600.0",
    "@aws-sdk/client-eventbridge": "^3.600.0",
    "@aws-sdk/client-sfn": "^3.600.0",
    "@aws-sdk/client-sqs": "^3.600.0",
    "@aws-sdk/lib-dynamodb": "^3.600.0",
    "@nx/eslint-plugin": "^20.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "nx": "^20.0.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.2.0"
  }
}
