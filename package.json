{
  "name": "playfusion-web",
  "private": true,
  "type": "module",
  "engines": { "node": ">=20 <21" },
  "workspaces": [
    "apps/*",
    "libs/*",
    "services/*",
    "infra/*",
    "mockups"
  ],
  "scripts": {
    "build": "nx run-many -t build",
    "test": "nx run-many -t test",
    "lint": "nx run-many -t lint",
    "graph": "nx graph",
    "mockups": "npm run dev -w @playfusion/mockups"
  },
  "devDependencies": {
    "@nx/eslint-plugin": "^20.0.0",
    "@types/node": "^20.14.0",
    "eslint": "^9.0.0",
    "nx": "^20.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.1.0"
  }
}
